<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read-only import of existing contacts/call log; no write-back needed for archive -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Only used when the user explicitly enables encrypted cloud backup -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- READ_PHONE_STATE / PROCESS_OUTGOING_CALLS imply telephony hardware by
         default, which would wrongly exclude Chromebooks/tablets/other
         non-phone devices from the Play Store listing. Cairn's call archive
         features are simply inactive (nothing to import/listen for) on a
         device with no telephony — so this is correctly optional. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".CairnApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cairn"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true">
        <!-- extractNativeLibs=true: SQLCipher's native library has a well-documented
             UnsatisfiedLinkError failure mode on real devices when the .so is left
             compressed inside the APK instead of extracted at install time — see
             CairnDatabase.kt (System.loadLibrary("sqlcipher")) and the matching
             packagingOptions.jniLibs.useLegacyPackaging setting in build.gradle.kts. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Cairn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Listens for new calls to append to the archive in near-real-time -->
        <receiver
            android:name=".worker.CallLogReceiver"
            android:exported="true"
            android:permission="android.permission.PROCESS_OUTGOING_CALLS">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- CairnApplication implements androidx.work.Configuration.Provider for
             on-demand WorkManager initialization (see VaultApplication/CairnApplication.kt),
             which requires explicitly removing the default WorkManagerInitializer
             entry that androidx.startup would otherwise auto-register — lint enforces
             this (RemoveWorkManagerInitializer) since having both active is invalid. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
