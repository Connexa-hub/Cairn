# Copy to .env for local dev. On Render, set these in the dashboard as env vars instead.

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=changeme-generate-a-real-secret

# sqlite:///./cairn_backend.db for local/dev or Render's free SQLite disk,
# postgresql://user:pass@host:5432/dbname for Render Postgres.
DATABASE_URL=sqlite:///./cairn_backend.db

# Directory where encrypted backup blobs are stored on disk (mount a Render persistent disk here in prod)
STORAGE_DIR=./storage

# Max upload size per backup, in megabytes
MAX_UPLOAD_MB=200

# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=10080
