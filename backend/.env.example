# Copy to .env for local dev. On Render, set these in the dashboard as env vars instead.

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=changeme-generate-a-real-secret

# sqlite:///./cairn_backend.db for local/dev,
# postgresql://user:pass@host:5432/dbname for Render Postgres (or any Postgres).
DATABASE_URL=sqlite:///./cairn_backend.db

# Max upload size per backup, in megabytes. Backups are stored as rows in
# this same database (not on disk — see app/models/models.py), so keep this
# modest on a free-tier Postgres instance (~1GB total storage available).
MAX_UPLOAD_MB=50

# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=10080
